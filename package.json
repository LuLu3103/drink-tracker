{
  "name": "drink-tracker",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "个人咖啡 / 奶茶咖啡因与营养追踪工具（PWA）",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "esbuild tools/smoke.ts --bundle --platform=node --format=esm --target=node20 --outfile=tools/smoke.mjs --alias:@=./src --log-level=warning && node tools/smoke.mjs",
    "icons": "python tools/gen_icons.py"
  },
  "dependencies": {
    "dexie": "^4.0.4",
    "echarts": "^5.5.0",
    "lucide-react": "^0.462.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "fake-indexeddb": "^6.2.8",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.0",
    "vite-plugin-pwa": "^0.19.2",
    "workbox-window": "^7.0.0"
  }
}
